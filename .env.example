# =====================================================
# Variables de entorno para despliegue Cloud — FitZone
# Copiar como .env en local o configurar en Render/Railway/AWS
# =====================================================

PORT=8080
APP_BASE_URL=https://tu-backend-fitzone.onrender.com

# Base de datos MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/fitzone_db?retryWrites=true&w=majority
MONGODB_DATABASE=fitzone_db

# Seguridad JWT (usar clave larga aleatoria en producción)
JWT_SECRET=reemplaza_con_una_clave_secreta_muy_larga_de_minimo_64_caracteres

# Groq LLM API (FitBot)
GROQ_API_KEY=gsk_tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-120b

# Correo SMTP (verificación de cuentas web)
MAIL_USERNAME=fitzonegym.oficial@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail

# Binario Python (en Docker se configura automáticamente /opt/venv/bin/python)
PYTHON_BIN=python3
